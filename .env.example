# IPTraceX local configuration — copy to .env and adjust.
# NEVER commit .env with real values. See README.md / docs/configuration.md.
#
# cp .env.example .env

# Optional. The default providers need NO key.
# Set only if you switch to a provider that requires one.
IPTRACEX_API_KEY=

# Comma-separated GeoIP providers in priority order.
IPTRACEX_PROVIDERS=ipwho.is,ipapi.co,ipinfo.io

# Intel providers (ripestat, doh-cloudflare, doh-google, system-dns,
# tor-exits, cloud-ranges, abuseipdb).
IPTRACEX_INTEL=ripestat,doh-cloudflare,doh-google,system-dns,tor-exits,cloud-ranges

# Optional ipinfo.io token (raises quota). Anonymous tier works without it.
IPINFO_TOKEN=

# Optional AbuseIPDB key (enables reputation signals). Skipped if empty.
IPTRACEX_ABUSEIPDB_KEY=

# Optional HIBP key (enables email breach metadata). Skipped if empty.
IPTRACEX_HIBP_API_KEY=

# Optional GitHub token (email commit-authorship footprint). Skipped if empty.
IPTRACEX_GITHUB_TOKEN=

# Email risk weights, e.g. disposable=20,breach=10,suspicious=15.
IPTRACEX_EMAIL_RISK_WEIGHTS=

# Per-provider HTTP timeout in seconds (default: 10, clamped 1-60).
IPTRACEX_TIMEOUT=10

# Whole-investigation timeout in seconds (default: 90, clamped 10-600).
IPTRACEX_GLOBAL_TIMEOUT=90

# Max intel providers queried concurrently (default: 4, clamped 1-16).
IPTRACEX_MAX_CONCURRENCY=4

# Risk weights, e.g. tor=35,proxy=20,hosting=15,vpn=15,abuse=25.
IPTRACEX_RISK_WEIGHTS=

# Local cache TTL in seconds (default: 3600). Set to 0 to disable cache.
IPTRACEX_CACHE_TTL=3600

# Set to 1 to force colorless output.
IPTRACEX_NO_COLOR=

# Set to 1 for verbose debug logging (never prints secrets).
IPTRACEX_DEBUG=
